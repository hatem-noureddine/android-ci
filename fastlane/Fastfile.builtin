# ==============================================================================
# hateum/android-ci-box: Universal Built-in Fastfile (/opt/fastlane/Fastfile)
# Turnkey Android CI/CD Lanes with Zero Project Configuration
# ==============================================================================

default_platform(:android)

platform :android do

  # ----------------------------------------------------------------------------
  # Helper: Execute Gradle with optimal CI flags
  # ----------------------------------------------------------------------------
  def run_gradle_task(task_name)
    gradle(
      task: task_name,
      flags: "--no-daemon --stacktrace --build-cache"
    )
  end

  # ============================================================================
  # 1. Quality & Testing Lanes
  # ============================================================================

  desc "Run JUnit Unit Tests across all modules"
  lane :test do
    UI.message("🧪 Running Unit Tests...")
    run_gradle_task("test")
    UI.success("✔ Unit tests completed successfully!")
  end

  desc "Run Android Lint static analysis"
  lane :lint do
    UI.message("🔍 Running Android Lint...")
    begin
      run_gradle_task("lint lintRelease")
    rescue => e
      UI.error("Lint reported issues or warnings. Check build/reports/lint-results.html")
      raise e
    end
    UI.success("✔ Lint static analysis passed!")
  end

  desc "Run Detekt Kotlin static analysis and code smells check"
  lane :detekt do
    UI.message("🛡️ Running Detekt Kotlin Linter...")
    begin
      run_gradle_task("detekt")
      UI.success("✔ Detekt analysis passed!")
    rescue => e
      UI.important("Notice: Detekt task failed or is not configured in this project. Continuing...")
    end
  end

  desc "Run SonarQube / SonarCloud Code Quality Analysis"
  lane :sonar do
    sonar_token = ENV["SONAR_TOKEN"]
    sonar_host = ENV["SONAR_HOST_URL"] || "https://sonarcloud.io"

    if sonar_token.to_s.empty?
      UI.user_error!("Missing SONAR_TOKEN environment variable.")
    end

    UI.message("📊 Running Sonar Analysis against #{sonar_host}...")
    run_gradle_task("sonar -Dsonar.host.url=#{sonar_host} -Dsonar.token=#{sonar_token}")
    UI.success("✔ Sonar analysis submitted successfully!")
  end

  desc "Run Screenshot Tests (Roborazzi or Paparazzi)"
  lane :screenshot_tests do
    UI.message("📸 Running Screenshot Tests...")
    begin
      run_gradle_task("verifyRoborazziDebug")
    rescue
      begin
        run_gradle_task("verifyPaparazziDebug")
      rescue
        UI.important("No Roborazzi or Paparazzi verification task found in project.")
      end
    end
  end

  # ============================================================================
  # 2. Packaging & Branding Lanes
  # ============================================================================

  desc "Assemble Debug APK"
  lane :build_debug do
    UI.message("📦 Compiling Debug APK...")
    run_gradle_task("assembleDebug")
    UI.success("✔ Debug APK generated successfully!")
  end

  desc "Assemble Release APK"
  lane :build_release do
    UI.message("📦 Compiling Release APK...")
    run_gradle_task("assembleRelease")
    UI.success("✔ Release APK generated successfully!")
  end

  desc "Assemble Android App Bundle (.aab) for Google Play"
  lane :bundle do
    UI.message("📦 Compiling Release Android App Bundle (.aab)...")
    run_gradle_task("bundleRelease")
    UI.success("✔ Release AAB generated successfully!")
  end

  desc "Apply a visual ribbon/badge overlay on launcher icons (QA, BETA, DEV)"
  lane :badge do
    badge_text = ENV["BADGE_TEXT"] || "BETA"
    badge_color = ENV["BADGE_COLOR"] || "#FF5722"
    badge_gravity = ENV["BADGE_GRAVITY"] || "bottom"
    shield_version = ENV["BADGE_SHIELD"]

    UI.message("🏷️ Applying '#{badge_text}' ribbon badge to launcher icons (Color: #{badge_color}, Gravity: #{badge_gravity})...")

    icon_dirs = Dir.glob("**/src/main/res/mipmap-*").select { |d| File.directory?(d) }
    if icon_dirs.empty?
      icon_dirs = Dir.glob("**/src/main/res/drawable-*").select { |d| File.directory?(d) }
    end

    if icon_dirs.empty?
      UI.important("No launcher icon directory (mipmap-* / drawable-*) found to badge.")
    else
      icon_dirs.each do |dir|
        Dir.glob("#{dir}/ic_launcher*.png").each do |icon|
          UI.message("  Badging #{icon} with [#{badge_text}]...")
          # Apply banner or shield with ImageMagick or Python script if available
          sh("python3 -c \"
import os, sys
from PIL import Image, ImageDraw, ImageFont
try:
    img = Image.open('#{icon}').convert('RGBA')
    draw = ImageDraw.Draw(img)
    w, h = img.size
    banner_h = int(h * 0.25)
    banner_y = h - banner_h if '#{badge_gravity}' == 'bottom' else 0
    # Overlay semi-transparent rectangle
    overlay = Image.new('RGBA', img.size, (0, 0, 0, 0))
    ov_draw = ImageDraw.Draw(overlay)
    ov_draw.rectangle([0, banner_y, w, banner_y + banner_h], fill=(230, 81, 0, 220))
    img = Image.alpha_composite(img, overlay)
    img.save('#{icon}')
    print('  ✔ Badged #{icon}')
except Exception as e:
    print(f'  [Notice] PIL badging skipped: {e}')
\" || true")
        end
      end
      UI.success("✔ App launcher icons badged successfully!")
    end
  end

  # ============================================================================
  # 3. Signature & Distribution Lanes
  # ============================================================================

  desc "Sign APK or AAB using a Base64-encoded Keystore"
  lane :sign do
    keystore_b64 = ENV["KEYSTORE_BASE64"]
    keystore_path = ENV["KEYSTORE_PATH"] || "/tmp/keystore.jks"
    keystore_password = ENV["KEYSTORE_PASSWORD"]
    key_alias = ENV["KEY_ALIAS"]
    key_password = ENV["KEY_PASSWORD"] || keystore_password

    if keystore_b64.to_s.empty? && !File.exist?(keystore_path.to_s)
      UI.user_error!("Missing KEYSTORE_BASE64 or KEYSTORE_PATH environment variable.")
    end

    if keystore_b64 && !keystore_b64.empty?
      UI.message("🔐 Decoding KEYSTORE_BASE64 to temporary keystore...")
      File.open(keystore_path, "wb") do |f|
        f.write(Base64.decode64(keystore_b64))
      end
    end

    # Sign APKs if found
    apks = Dir.glob("**/build/outputs/apk/release/*-unsigned.apk") + Dir.glob("**/build/outputs/apk/release/*-unaligned.apk")
    if apks.empty?
      apks = Dir.glob("**/build/outputs/apk/release/*.apk")
    end

    apks.each do |apk|
      UI.message("Signing APK: #{apk}...")
      sh("apksigner sign --ks '#{keystore_path}' --ks-pass 'pass:#{keystore_password}' --ks-key-alias '#{key_alias}' --key-pass 'pass:#{key_password}' '#{apk}' || true")
    end

    UI.success("✔ Artifact signature completed successfully!")
  end

  desc "Distribute APK/AAB to Firebase App Distribution"
  lane :distribute_firebase do
    app_id = ENV["FIREBASE_APP_ID"]
    token = ENV["FIREBASE_TOKEN"]
    groups = ENV["FIREBASE_GROUPS"] || "testers"
    notes = ENV["FIREBASE_RELEASE_NOTES"] || "Automated build from hateum/android-ci-box"

    if app_id.to_s.empty?
      UI.user_error!("Missing FIREBASE_APP_ID environment variable.")
    end

    artifact = Dir.glob("**/build/outputs/apk/release/*.apk").first || Dir.glob("**/build/outputs/bundle/release/*.aab").first

    if artifact.nil?
      UI.user_error!("No APK or AAB found to distribute. Run 'ci-lane build_release' or 'ci-lane bundle' first.")
    end

    UI.message("🚀 Uploading #{artifact} to Firebase App Distribution...")
    firebase_app_distribution(
      app: app_id,
      groups: groups,
      release_notes: notes,
      android_artifact_type: artifact.end_with?(".aab") ? "AAB" : "APK",
      android_artifact_path: artifact,
      firebase_cli_token: token
    )
    UI.success("✔ Distributed to Firebase App Distribution successfully!")
  end

  desc "Deploy Release AAB to Google Play Console"
  lane :distribute_playstore do
    track = ENV["PLAY_TRACK"] || "internal"
    rollout = ENV["PLAY_ROLLOUT_PERCENTAGE"] ? ENV["PLAY_ROLLOUT_PERCENTAGE"].to_f / 100.0 : 1.0
    json_key_b64 = ENV["GOOGLE_PLAY_KEY_BASE64"]
    json_key_file = ENV["SUPPLY_JSON_KEY"] || "/tmp/play_key.json"

    if json_key_b64 && !json_key_b64.empty?
      File.open(json_key_file, "wb") { |f| f.write(Base64.decode64(json_key_b64)) }
    end

    aab = Dir.glob("**/build/outputs/bundle/release/*.aab").first
    if aab.nil?
      UI.user_error!("No release AAB found. Run 'ci-lane bundle' first.")
    end

    UI.message("🚀 Publishing #{aab} to Google Play track: #{track} (Rollout: #{rollout * 100}%)...")
    upload_to_play_store(
      track: track,
      aab: aab,
      rollout: rollout.to_s,
      json_key: json_key_file,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
    UI.success("✔ Published to Google Play Console successfully!")
  end

  desc "Upload assembled artifacts (APK/AAB) to GitHub Release via gh CLI"
  lane :distribute_github do
    artifacts = Dir.glob("**/build/outputs/apk/release/*.apk") + Dir.glob("**/build/outputs/bundle/release/*.aab")
    if artifacts.empty?
      UI.user_error!("No release artifacts found to upload.")
    end

    tag = ENV["GITHUB_REF_NAME"] || ENV["CI_COMMIT_TAG"] || "v#{Time.now.strftime('%Y%m%d%H%M%S')}"
    UI.message("🐙 Uploading artifacts to GitHub Release #{tag}...")
    artifacts.each do |art|
      sh("gh release upload '#{tag}' '#{art}' --clobber || true")
    end
    UI.success("✔ Artifacts uploaded to GitHub Release successfully!")
  end

  # ============================================================================
  # 4. ChatOps & Notification Lanes
  # ============================================================================

  desc "Send notification to Slack"
  lane :notify_slack do
    webhook = ENV["SLACK_WEBHOOK_URL"]
    if webhook.to_s.empty?
      UI.important("SLACK_WEBHOOK_URL is not set. Skipping Slack notification.")
      next
    end

    status_text = ENV["CI_BUILD_STATUS"] || "SUCCESS"
    channel = ENV["SLACK_CHANNEL"]
    slack(
      message: "🤖 [Android CI Box] Pipeline status: *#{status_text}*",
      slack_url: webhook,
      channel: channel,
      success: status_text == "SUCCESS",
      payload: {
        "Commit" => ENV["GITHUB_SHA"] || ENV["CI_COMMIT_SHA"] || "local",
        "Branch" => ENV["GITHUB_REF_NAME"] || ENV["CI_COMMIT_REF_NAME"] || "main",
      }
    )
  end

  desc "Send notification to Microsoft Teams"
  lane :notify_teams do
    webhook = ENV["TEAMS_WEBHOOK_URL"]
    if webhook.to_s.empty?
      UI.important("TEAMS_WEBHOOK_URL is not set. Skipping Teams notification.")
      next
    end

    status_text = ENV["CI_BUILD_STATUS"] || "SUCCESS"
    color = status_text == "SUCCESS" ? "2eb886" : "d9534f"
    sh("curl -fsSL -H 'Content-Type: application/json' -d '{
      \"@type\": \"MessageCard\",
      \"themeColor\": \"#{color}\",
      \"title\": \"Android CI/CD Build: #{status_text}\",
      \"text\": \"Pipeline executed via hateum/android-ci-box\"
    }' '#{webhook}' || true")
  end

  desc "Smart multi-channel notification (Slack, Teams, Discord, Telegram)"
  lane :notify do
    notify_slack if ENV["SLACK_WEBHOOK_URL"]
    notify_teams if ENV["TEAMS_WEBHOOK_URL"]
    
    if ENV["DISCORD_WEBHOOK_URL"]
      status_text = ENV["CI_BUILD_STATUS"] || "SUCCESS"
      sh("curl -fsSL -H 'Content-Type: application/json' -d '{\"content\": \"📱 **Android CI/CD Build #{status_text}**\"}' '#{ENV["DISCORD_WEBHOOK_URL"]}' || true")
    end

    if ENV["TELEGRAM_BOT_TOKEN"] && ENV["TELEGRAM_CHAT_ID"]
      status_text = ENV["CI_BUILD_STATUS"] || "SUCCESS"
      sh("curl -fsSL -X POST 'https://api.telegram.org/bot#{ENV["TELEGRAM_BOT_TOKEN"]}/sendMessage' -d 'chat_id=#{ENV["TELEGRAM_CHAT_ID"]}&text=Android CI/CD Build #{status_text}' || true")
    end
    UI.success("✔ Notifications dispatched.")
  end

  # ============================================================================
  # 5. Version Control & Tagging Lanes
  # ============================================================================

  desc "Generate CHANGELOG.md from Conventional Commits since the last Git tag"
  lane :changelog do
    output_file = ENV["CHANGELOG_FILE"] || "CHANGELOG.md"
    since_tag = sh("git describe --tags --abbrev=0 2>/dev/null || echo ''", log: false).strip
    since_ref = since_tag.empty? ? "--all" : "#{since_tag}..HEAD"

    UI.message("📋 Generating changelog from #{since_tag.empty? ? 'all commits' : "#{since_tag} → HEAD"}...")

    raw_log = sh("git log #{since_ref} --pretty=format:'%h|%s|%an' 2>/dev/null", log: false).strip
    if raw_log.empty?
      UI.important("No commits found since last tag. Skipping changelog generation.")
      next
    end

    sections = { "feat" => [], "fix" => [], "perf" => [], "refactor" => [],
                 "docs" => [], "test" => [], "chore" => [], "other" => [] }

    raw_log.split("\n").each do |line|
      parts = line.split("|", 3)
      next unless parts.length == 3
      sha, subject, author = parts
      type = subject.match(/^(\w+)[\(!:]/)&.captures&.first || "other"
      sections.key?(type) ? sections[type] << "- #{subject} (`#{sha}`) — #{author}" : sections["other"] << "- #{subject} (`#{sha}`) — #{author}"
    end

    version_name = sh("grep -m1 'versionName' app/build.gradle* 2>/dev/null | grep -oP '\"\\K[^\"]+' || echo 'unreleased'", log: false).strip
    date_str = Time.now.strftime("%Y-%m-%d")
    content = "# Changelog\n\n## [#{version_name}] — #{date_str}\n\n"

    type_labels = { "feat" => "🚀 Features", "fix" => "🐛 Bug Fixes", "perf" => "⚡ Performance",
                    "refactor" => "♻️ Refactoring", "docs" => "📚 Documentation", "test" => "🧪 Tests",
                    "chore" => "🔧 Chores", "other" => "📦 Other" }

    sections.each do |type, entries|
      next if entries.empty?
      content += "### #{type_labels[type]}\n#{entries.join("\n")}\n\n"
    end

    existing = File.exist?(output_file) ? File.read(output_file).sub(/^# Changelog\n/, "") : ""
    File.write(output_file, content + existing)
    UI.success("✔ Changelog written to #{output_file}")
  end

  desc "Create and push a Git tag vX.Y.Z from the app versionName"
  lane :git_tag do
    version_name = sh("grep -m1 'versionName' app/build.gradle* 2>/dev/null | grep -oP '\"\\K[^\"]+' || echo ''", log: false).strip
    if version_name.empty?
      UI.user_error!("Could not extract versionName from app/build.gradle. Set GIT_TAG_NAME env var or fix your build file.")
    end
    tag = ENV["GIT_TAG_NAME"] || "v#{version_name}"
    branch = ENV["GITHUB_REF_NAME"] || ENV["CI_COMMIT_REF_NAME"] || sh("git rev-parse --abbrev-ref HEAD", log: false).strip
    UI.message("🏷️  Creating Git tag #{tag} on #{branch}...")
    sh("git config user.email 'ci@android-ci-box' && git config user.name 'Android CI Box' || true")
    sh("git tag -a '#{tag}' -m 'Release #{tag} — built by hateum/android-ci-box' 2>/dev/null || true")
    sh("git push origin '#{tag}' 2>/dev/null || true")
    UI.success("✔ Git tag #{tag} created and pushed.")
  end

  # ============================================================================
  # 6. Additional Store Distribution Lanes
  # ============================================================================

  desc "Deploy Release AAB to Google Play internal track (shortcut for PLAY_TRACK=internal)"
  lane :deploy_alpha do
    UI.message("🔑 Deploying to Google Play internal track (alpha)...")
    ENV["PLAY_TRACK"] = "internal"
    distribute_playstore
  end

  desc "Deploy Release AAB to Google Play production track with configurable rollout"
  lane :deploy_production do
    rollout = ENV["PLAY_ROLLOUT_PERCENTAGE"] || "10"
    UI.message("🌍 Deploying to Google Play production track (#{rollout}% rollout)...")
    ENV["PLAY_TRACK"] = "production"
    ENV["PLAY_ROLLOUT_PERCENTAGE"] = rollout
    distribute_playstore
  end

  desc "Distribute APK/AAB to Microsoft App Center"
  lane :app_center do
    api_token   = ENV["APPCENTER_API_TOKEN"]
    owner_name  = ENV["APPCENTER_OWNER_NAME"]
    app_name    = ENV["APPCENTER_APP_NAME"]
    group       = ENV["APPCENTER_DISTRIBUTE_GROUP"] || "Testers"
    notes       = ENV["APPCENTER_RELEASE_NOTES"]   || "Automated build from hateum/android-ci-box"

    if api_token.to_s.empty? || owner_name.to_s.empty? || app_name.to_s.empty?
      UI.user_error!("Missing APPCENTER_API_TOKEN, APPCENTER_OWNER_NAME or APPCENTER_APP_NAME.")
    end

    artifact = Dir.glob("**/build/outputs/apk/release/*.apk").first \
            || Dir.glob("**/build/outputs/bundle/release/*.aab").first
    UI.user_error!("No APK or AAB found. Run 'ci-lane build_release' or 'ci-lane bundle' first.") if artifact.nil?

    UI.message("📱 Uploading #{artifact} to App Center #{owner_name}/#{app_name} → group: #{group}...")
    appcenter_upload(
      api_token:              api_token,
      owner_name:             owner_name,
      app_name:               app_name,
      file:                   artifact,
      notify_testers:         true,
      release_notes:          notes,
      destinations:           group
    )
    UI.success("✔ Uploaded to Microsoft App Center successfully!")
  end

  desc "Publish AAB to Huawei AppGallery Connect"
  lane :deploy_huawei do
    client_id      = ENV["HUAWEI_CLIENT_ID"]
    client_secret  = ENV["HUAWEI_CLIENT_SECRET"]
    app_id         = ENV["HUAWEI_APP_ID"]

    if client_id.to_s.empty? || client_secret.to_s.empty? || app_id.to_s.empty?
      UI.user_error!("Missing HUAWEI_CLIENT_ID, HUAWEI_CLIENT_SECRET or HUAWEI_APP_ID.")
    end

    aab = Dir.glob("**/build/outputs/bundle/release/*.aab").first \
       || Dir.glob("**/build/outputs/apk/release/*.apk").first
    UI.user_error!("No release artifact found. Run 'ci-lane bundle' or 'ci-lane build_release' first.") if aab.nil?

    UI.message("🔶 Authenticating with Huawei AppGallery Connect...")
    token_response = sh("curl -fsSL -X POST 'https://connect-api.cloud.huawei.com/api/oauth2/v1/token' \
      -H 'Content-Type: application/json' \
      -d '{\"grant_type\":\"client_credentials\",\"client_id\":\"#{client_id}\",\"client_secret\":\"#{client_secret}\"}'", log: false)
    access_token = JSON.parse(token_response)["access_token"]
    UI.user_error!("Failed to obtain Huawei access token.") if access_token.to_s.empty?

    UI.message("🔶 Requesting Huawei upload URL for app #{app_id}...")
    url_response = sh("curl -fsSL 'https://connect-api.cloud.huawei.com/api/publish/v2/upload-url?appId=#{app_id}&suffix=aab' \
      -H 'Authorization: Bearer #{access_token}' -H 'client_id: #{client_id}'", log: false)
    upload_url = JSON.parse(url_response).dig("uploadUrl")
    UI.user_error!("Failed to obtain Huawei upload URL.") if upload_url.to_s.empty?

    UI.message("🔶 Uploading #{aab} to Huawei AppGallery...")
    sh("curl -fsSL -X PUT '#{upload_url}' -H 'Authorization: Bearer #{access_token}' \
      -H 'client_id: #{client_id}' -F 'file=@#{aab}'")
    UI.success("✔ Uploaded to Huawei AppGallery Connect successfully!")
  end

  desc "Publish APK/AAB to Samsung Galaxy Store via Seller Portal API"
  lane :deploy_samsung do
    service_account = ENV["SAMSUNG_SERVICE_ACCOUNT"]
    access_key      = ENV["SAMSUNG_ACCESS_KEY"]
    content_id      = ENV["SAMSUNG_CONTENT_ID"]

    if service_account.to_s.empty? || access_key.to_s.empty? || content_id.to_s.empty?
      UI.user_error!("Missing SAMSUNG_SERVICE_ACCOUNT, SAMSUNG_ACCESS_KEY or SAMSUNG_CONTENT_ID.")
    end

    artifact = Dir.glob("**/build/outputs/apk/release/*.apk").first \
            || Dir.glob("**/build/outputs/bundle/release/*.aab").first
    UI.user_error!("No release artifact found. Run 'ci-lane build_release' or 'ci-lane bundle' first.") if artifact.nil?

    UI.message("🔵 Authenticating with Samsung Galaxy Store Seller Portal API...")
    token_response = sh("curl -fsSL -X POST 'https://devapi.samsungapps.com/auth/accessToken' \
      -H 'Content-Type: application/json' \
      -d '{\"serviceAccountId\":\"#{service_account}\",\"accessKey\":\"#{access_key}\"}'", log: false)
    session_token = JSON.parse(token_response)["sessionToken"]
    UI.user_error!("Failed to obtain Samsung session token.") if session_token.to_s.empty?

    UI.message("🔵 Uploading #{artifact} to Samsung Galaxy Store content #{content_id}...")
    sh("curl -fsSL -X POST 'https://devapi.samsungapps.com/seller/contentEdit/uploadFile' \
      -H 'Authorization: Bearer #{session_token}' \
      -F 'contentId=#{content_id}' -F 'file=@#{artifact}'")
    UI.success("✔ Uploaded to Samsung Galaxy Store successfully!")
  end

  # ============================================================================
  # 7. Quality Metrics & Security Lanes
  # ============================================================================

  desc "Analyze APK permissions and certificate with apkanalyzer (security audit)"
  lane :security_scan do
    apks = Dir.glob("**/build/outputs/apk/**/*.apk") + Dir.glob("**/build/outputs/bundle/**/*.aab")
    if apks.empty?
      UI.important("No APK or AAB found for security_scan. Build first with 'ci-lane build_release' or 'ci-lane bundle'.")
      next
    end

    apkanalyzer = "#{ENV['ANDROID_HOME']}/cmdline-tools/latest/bin/apkanalyzer"
    unless File.executable?(apkanalyzer)
      UI.important("apkanalyzer not found at #{apkanalyzer}. Skipping security scan.")
      next
    end

    dangerous_permissions = %w[
      android.permission.READ_CONTACTS android.permission.WRITE_CONTACTS
      android.permission.READ_SMS android.permission.RECEIVE_SMS android.permission.SEND_SMS
      android.permission.ACCESS_FINE_LOCATION android.permission.RECORD_AUDIO
      android.permission.CAMERA android.permission.READ_CALL_LOG
      android.permission.PROCESS_OUTGOING_CALLS android.permission.READ_EXTERNAL_STORAGE
      android.permission.WRITE_EXTERNAL_STORAGE
    ]

    apks.each do |artifact|
      next unless artifact.end_with?(".apk")
      UI.message("🛡️  Scanning #{artifact}...")

      perms_output = sh("'#{apkanalyzer}' manifest permissions '#{artifact}' 2>/dev/null || true", log: false)
      found_dangerous = dangerous_permissions.select { |p| perms_output.include?(p) }
      if found_dangerous.any?
        UI.important("⚠️  SECURITY NOTICE — Dangerous permissions detected in #{artifact}:")
        found_dangerous.each { |p| UI.important("    • #{p}") }
      else
        UI.success("  ✔ No dangerous permissions detected in #{artifact}.")
      end

      cert_output = sh("'#{apkanalyzer}' apk cert-info '#{artifact}' 2>/dev/null || true", log: false)
      if cert_output =~ /Valid until:\s+(.+)/
        expiry = $1.strip
        UI.message("  Certificate valid until: #{expiry}")
      end
    end
    UI.success("✔ Security scan completed.")
  end

  desc "Run Jacoco code coverage and enforce a minimum threshold (default: 80%)"
  lane :code_coverage do
    threshold = (ENV["COVERAGE_THRESHOLD"] || "80").to_i
    UI.message("📊 Running Jacoco Code Coverage (minimum: #{threshold}%)...")

    begin
      run_gradle_task("jacocoTestReport")
    rescue => e
      UI.important("Jacoco task failed or not configured: #{e.message}. Continuing...")
      next
    end

    # Parse the XML report to compute line coverage
    report_files = Dir.glob("**/build/reports/jacoco/**/*.xml")
    if report_files.empty?
      UI.important("No Jacoco XML report found. Make sure the jacocoTestReport task generates XML output.")
      next
    end

    report_files.each do |report|
      content = File.read(report)
      line_missed  = content.scan(/<counter type="LINE" missed="(\d+)"/).flatten.map(&:to_i).sum
      line_covered = content.scan(/<counter type="LINE" missed="\d+" covered="(\d+)"/).flatten.map(&:to_i).sum
      total = line_missed + line_covered
      coverage = total > 0 ? ((line_covered.to_f / total) * 100).round(1) : 0

      UI.message("  #{File.dirname(report)}: Line Coverage = #{coverage}%")
      if coverage < threshold
        UI.user_error!("❌ Code coverage #{coverage}% is below minimum threshold of #{threshold}%.")
      else
        UI.success("  ✔ Coverage #{coverage}% meets the #{threshold}% threshold.")
      end
    end
    UI.success("✔ Jacoco code coverage gate passed!")
  end

  desc "Audit APK/AAB artifact size and warn if it exceeds a configurable threshold"
  lane :apk_size_audit do
    warn_threshold_pct = (ENV["APK_SIZE_WARN_THRESHOLD_PCT"] || "10").to_f
    warn_threshold_mb  = ENV["APK_SIZE_WARN_THRESHOLD_MB"]
    baseline_mb_str    = ENV["APK_SIZE_BASELINE_MB"]

    artifacts = Dir.glob("**/build/outputs/apk/release/*.apk") + Dir.glob("**/build/outputs/bundle/release/*.aab")
    if artifacts.empty?
      UI.important("No release artifacts found for apk_size_audit. Run 'ci-lane build_release' or 'ci-lane bundle' first.")
      next
    end

    artifacts.each do |artifact|
      size_bytes = File.size(artifact)
      size_mb    = (size_bytes / 1_048_576.0).round(2)
      UI.message("📦 #{File.basename(artifact)}: #{size_mb} MB (#{size_bytes} bytes)")

      if baseline_mb_str
        baseline_mb = baseline_mb_str.to_f
        diff_pct = ((size_mb - baseline_mb) / baseline_mb * 100).round(1)
        limit_pct = warn_threshold_pct
        limit_mb  = warn_threshold_mb ? warn_threshold_mb.to_f : nil

        over_pct = diff_pct > limit_pct
        over_mb  = limit_mb && size_mb > limit_mb

        if over_pct || over_mb
          UI.important("⚠️  SIZE WARNING — #{File.basename(artifact)}: #{size_mb} MB " \
                       "(baseline: #{baseline_mb} MB, Δ #{diff_pct > 0 ? '+' : ''}#{diff_pct}%)")
          UI.important("    Set APK_SIZE_BASELINE_MB to track regressions, APK_SIZE_WARN_THRESHOLD_PCT to adjust the % warning (default: 10%).")
        else
          UI.success("  ✔ #{File.basename(artifact)} size #{size_mb} MB — within acceptable bounds (Δ #{diff_pct > 0 ? '+' : ''}#{diff_pct}% vs baseline #{baseline_mb} MB).")
        end
      else
        UI.important("  ℹ️  No APK_SIZE_BASELINE_MB set. Reporting size #{size_mb} MB without baseline comparison.")
        UI.important("    Tip: Set APK_SIZE_BASELINE_MB=#{size_mb} in your CI environment to track future regressions.")
      end
    end
    UI.success("✔ APK size audit complete.")
  end

  desc "Run Jetpack Macrobenchmark and extract performance metrics to JSON"
  lane :perf_baseline do
    module_name = ENV["BENCHMARK_MODULE"] || "benchmarks"
    test_class  = ENV["BENCHMARK_CLASS"]  || ""
    output_dir  = ENV["BENCHMARK_OUTPUT"] || "build/benchmark-results"

    UI.message("⚡ Running Jetpack Macrobenchmark (module: #{module_name})...")
    task = test_class.empty? ? ":#{module_name}:connectedReleaseAndroidTest" \
                             : ":#{module_name}:connectedReleaseAndroidTest --tests '#{test_class}'"
    begin
      run_gradle_task(task)
    rescue => e
      UI.important("Benchmark run encountered an error: #{e.message}. Attempting to extract partial results...")
    end

    # Aggregate JSON results from device
    json_files = Dir.glob("**/outputs/androidTest-results/**/*.json") + Dir.glob("**/benchmark/**/*.json")
    if json_files.empty?
      UI.important("No benchmark JSON results found. Ensure your Macrobenchmark module targets a physical device or emulator.")
      next
    end

    sh("mkdir -p '#{output_dir}'")
    aggregated = { "source" => "hateum/android-ci-box perf_baseline", "run_at" => Time.now.iso8601, "results" => [] }
    json_files.each do |f|
      begin
        data = JSON.parse(File.read(f))
        aggregated["results"] << data
      rescue
        UI.important("Could not parse #{f} as JSON — skipping.")
      end
    end

    report_path = "#{output_dir}/perf_baseline_#{Time.now.strftime('%Y%m%d_%H%M%S')}.json"
    File.write(report_path, JSON.pretty_generate(aggregated))
    UI.success("✔ Performance baseline report written to #{report_path}")
    UI.message("  Tip: Set BENCHMARK_OUTPUT to change the output directory.")
  end

  # ============================================================================
  # 8. Composite Turnkey Pipelines
  # ============================================================================

  desc "Complete Turnkey Pipeline: lint + detekt + test + build_release + bundle"
  lane :all do
    UI.message("🚀 Starting Full Android Turnkey CI Pipeline...")
    lint
    detekt
    test
    build_release
    bundle
    UI.success("🎉 Complete Android CI Pipeline passed with flying colors!")
  end

  desc "Full Release Pipeline: sign + bundle + distribute (Play Store + Firebase) + git_tag + changelog + notify"
  lane :release do
    UI.message("🚢 Starting Full Release Pipeline...")
    sign if ENV["KEYSTORE_BASE64"] || ENV["KEYSTORE_PATH"]
    bundle
    changelog
    distribute_playstore if ENV["GOOGLE_PLAY_KEY_BASE64"] || ENV["SUPPLY_JSON_KEY"]
    distribute_firebase  if ENV["FIREBASE_APP_ID"]
    git_tag
    notify
    UI.success("🎉 Release pipeline completed successfully!")
  end

  desc "Clean Gradle build caches and daemons"
  lane :clean do
    UI.message("🧹 Cleaning Gradle cache...")
    run_gradle_task("clean")
    UI.success("✔ Workspace cleaned.")
  end

end
