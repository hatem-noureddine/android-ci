#!/bin/bash
set -euo pipefail

TARGET="${1:-}"
if [ -z "$TARGET" ]; then
  echo "Usage: install-sdk-version <platform_number_or_package>"
  echo "Examples: install-sdk-version 37"
  echo "          install-sdk-version \"platforms;android-34\""
  exit 1
fi

SDKMANAGER="${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager"

# Pre-accept licenses safely without pipefail SIGPIPE
printf 'y\n%.0s' {1..30} | "$SDKMANAGER" --licenses >/dev/null 2>&1 || true

if [[ "$TARGET" =~ ^[0-9]+$ ]]; then
  echo "Installing Android platform $TARGET..."
  if [ "$TARGET" = "37" ]; then
    "$SDKMANAGER" "platforms;android-37.0" "build-tools;37.0.0" || "$SDKMANAGER" "platforms;android-37.0"
    if [ -d "${ANDROID_HOME}/platforms/android-37.0" ] && [ ! -d "${ANDROID_HOME}/platforms/android-37" ]; then
      ln -snf "${ANDROID_HOME}/platforms/android-37.0" "${ANDROID_HOME}/platforms/android-37"
    fi
  else
    "$SDKMANAGER" "platforms;android-${TARGET}" "build-tools;${TARGET}.0.0" || "$SDKMANAGER" "platforms;android-${TARGET}"
  fi
else
  "$SDKMANAGER" "$TARGET"
fi

echo "Finished installing $TARGET"
