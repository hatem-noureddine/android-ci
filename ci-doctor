#!/bin/bash
# ==============================================================================
# Android CI Doctor - Diagnostics & Connectivity Verification Tool
# ==============================================================================

BOLD="\033[1m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
CYAN="\033[0;36m"
RED="\033[0;31m"
RESET="\033[0m"

echo -e "${BOLD}${CYAN}=== Android CI Doctor (hateum/android-ci-box) ===${RESET}\n"

# 1. System & Execution User
echo -e "${BOLD}1. System & User Execution${RESET}"
echo -e "  OS Architecture : $(uname -m) ($(dpkg --print-architecture))"
echo -e "  Current User    : UID=$(id -u), GID=$(id -g), User=$(whoami 2>/dev/null || echo 'unknown')"
if [ "$(id -u)" -eq 0 ]; then
    echo -e "  Security Mode   : ${YELLOW}Root execution${RESET}"
else
    echo -e "  Security Mode   : ${GREEN}Non-Root / Hardened Runner execution (UID $(id -u))${RESET}"
fi
echo ""

# 2. Java Runtime
echo -e "${BOLD}2. Java Runtime${RESET}"
echo -e "  JAVA_HOME       : ${JAVA_HOME:-Not set}"
if command -v java >/dev/null 2>&1; then
    JAVA_VER=$(java -version 2>&1 | head -n 1)
    echo -e "  Active Version  : ${GREEN}${JAVA_VER}${RESET}"
else
    echo -e "  Active Version  : ${RED}Java not found in PATH!${RESET}"
fi
AVAILABLE_JDKS=$(find /opt -maxdepth 1 -name "jdk-*" -exec basename {} + 2>/dev/null | tr '\n' ' ')
echo -e "  Available JDKs  : ${AVAILABLE_JDKS:-None}"
echo ""

# 3. Android SDK Components
echo -e "${BOLD}3. Android SDK Components${RESET}"
echo -e "  ANDROID_HOME    : ${ANDROID_HOME:-Not set}"
if [ -d "$ANDROID_HOME/platforms" ]; then
    PLATFORMS=$(find "$ANDROID_HOME/platforms" -mindepth 1 -maxdepth 1 -exec basename {} + 2>/dev/null | tr '\n' ' ')
    echo -e "  Platforms       : ${GREEN}${PLATFORMS}${RESET}"
else
    echo -e "  Platforms       : ${RED}None installed${RESET}"
fi
if [ -d "$ANDROID_HOME/build-tools" ]; then
    BUILD_TOOLS=$(find "$ANDROID_HOME/build-tools" -mindepth 1 -maxdepth 1 -exec basename {} + 2>/dev/null | tr '\n' ' ')
    echo -e "  Build Tools     : ${GREEN}${BUILD_TOOLS}${RESET}"
else
    echo -e "  Build Tools     : ${RED}None installed${RESET}"
fi
echo ""

# 4. Automation & Deployment Tooling
echo -e "${BOLD}4. Automation & CLI Tooling${RESET}"
if command -v gradle >/dev/null 2>&1; then
    GRADLE_VER=$(gradle -version 2>&1 | grep "Gradle " | head -n 1 | awk '{print $2}')
    echo -e "  Gradle (Global) : ${GREEN}${GRADLE_VER:-Active}${RESET}"
else
    echo -e "  Gradle (Global) : ${RED}Not found${RESET}"
fi
if command -v fastlane >/dev/null 2>&1; then
    FASTLANE_VER=$( (fastlane --version 2>&1 || true) | head -n 1 | awk '{print $NF}')
    echo -e "  Fastlane        : ${GREEN}${FASTLANE_VER:-Active}${RESET}"
else
    echo -e "  Fastlane        : ${RED}Not found${RESET}"
fi
if command -v bundletool >/dev/null 2>&1; then
    echo -e "  Bundletool      : ${GREEN}1.18.3 wrapper active (/usr/local/bin/bundletool)${RESET}"
else
    echo -e "  Bundletool      : ${RED}Not found${RESET}"
fi
echo -e "  Ruby            : $(ruby -v 2>&1 | awk '{print $1, $2}')"
echo -e "  Python 3        : $(python3 --version 2>&1 | awk '{print $2}')"
echo -e "  GitHub CLI (gh) : $(gh --version 2>&1 | head -n 1 | awk '{print $3}')"
echo ""

# 5. Network & Internal Adapters
echo -e "${BOLD}5. Network Environment & Internal Adapters${RESET}"
# Check Proxy
PROXY_VAL="${HTTPS_PROXY:-${HTTP_PROXY:-}}"
if [ -n "$PROXY_VAL" ]; then
    echo -e "  HTTP/HTTPS Proxy: ${YELLOW}Active (${PROXY_VAL})${RESET}"
else
    echo -e "  HTTP/HTTPS Proxy: ${GREEN}Direct / Unrestricted (No proxy set)${RESET}"
fi

# Check CA Certificates
CA_COUNT=$(find /certificates /usr/local/share/ca-certificates -maxdepth 1 \( -name "*.crt" -o -name "*.pem" \) 2>/dev/null | wc -l)
if [ "$CA_COUNT" -gt 0 ]; then
    echo -e "  Corporate CA    : ${GREEN}${CA_COUNT} custom certificate(s) detected and registered${RESET}"
else
    echo -e "  Corporate CA    : ${CYAN}Standard Mozilla/Ubuntu root truststore${RESET}"
fi

# Check Nexus / Mirrors
MIRROR_VAL="${NEXUS_URLS:-${NEXUS_URL:-${INTERNAL_MAVEN_URL:-}}}"
if [ -n "$MIRROR_VAL" ]; then
    echo -e "  Nexus Mirror    : ${YELLOW}Active -> ${MIRROR_VAL}${RESET}"
    if [ -f /home/runner/.gradle/init.d/nexus-mirror.init.gradle ]; then
        echo -e "  Gradle Init Hook: ${GREEN}nexus-mirror.init.gradle configured${RESET}"
    fi
else
    echo -e "  Nexus Mirror    : ${GREEN}Standard direct repositories (Google, MavenCentral, GradlePortal)${RESET}"
fi

# Check Remote Build Cache
CACHE_VAL="${GRADLE_BUILD_CACHE_URL:-${GRADLE_REMOTE_CACHE_URL:-}}"
if [ -n "$CACHE_VAL" ]; then
    echo -e "  Build Cache HTTP: ${YELLOW}Active -> ${CACHE_VAL}${RESET}"
    if [ -f /home/runner/.gradle/init.d/remote-build-cache.init.gradle ]; then
        echo -e "  Build Cache Hook: ${GREEN}remote-build-cache.init.gradle configured${RESET}"
    fi
else
    echo -e "  Build Cache HTTP: ${CYAN}Local cache only (No remote HTTP build cache)${RESET}"
fi
# 6. Android Emulator & KVM Acceleration
echo -e "${BOLD}6. Android Emulator & KVM Hardware Acceleration${RESET}"
if command -v emulator >/dev/null 2>&1; then
    EMU_VERSION=$(emulator -version 2>&1 | head -n 1)
    echo -e "  Android Emulator: ${GREEN}${EMU_VERSION:-Active}${RESET}"
else
    ARCH_NAME=$(dpkg --print-architecture 2>/dev/null || uname -m)
    if [ "$ARCH_NAME" = "arm64" ] || [ "$ARCH_NAME" = "aarch64" ]; then
        echo -e "  Android Emulator: ${CYAN}x86_64 only (Google does not publish Linux ARM64 emulator; compilation & unit tests run at native ARM64 speed)${RESET}"
    else
        echo -e "  Android Emulator: ${YELLOW}Not in PATH or not installed${RESET}"
    fi
fi
echo -e "  AVD Directory   : ${ANDROID_AVD_HOME:-/home/runner/.android/avd}"
if [ -e /dev/kvm ]; then
    if [ -r /dev/kvm ] && [ -w /dev/kvm ]; then
        echo -e "  KVM Acceleration: ${GREEN}Available & R/W accessible (/dev/kvm)${RESET}"
    else
        echo -e "  KVM Acceleration: ${YELLOW}Present but check permissions (/dev/kvm)${RESET}"
    fi
else
    echo -e "  KVM Acceleration: ${YELLOW}Absent (Fallback: Software emulation swiftshader_indirect)${RESET}"
fi
echo ""

# 7. Connectivity Quick-Check
echo -e "${BOLD}7. Connectivity Probes${RESET}"
test_url() {
    local target="$1"
    local name="$2"
    if curl -s -m 3 -o /dev/null "$target"; then
        echo -e "  ${name} : ${GREEN}Reachable (HTTP OK)${RESET}"
    else
        echo -e "  ${name} : ${YELLOW}Unreachable or blocked (HTTP/DNS fail)${RESET}"
    fi
}

test_url "https://dl.google.com" "Google Android Maven (dl.google.com)"
test_url "https://repo.maven.apache.org" "Maven Central (repo.maven.apache.org)"

if [ -n "$NEXUS_URL" ]; then
    CLEAN_NEXUS=$(echo "$NEXUS_URL" | cut -d',' -f1 | tr -d ' ')
    test_url "$CLEAN_NEXUS" "Corporate Nexus (${CLEAN_NEXUS})"
fi

echo -e "\n${BOLD}${GREEN}✔ CI Doctor diagnostics complete!${RESET}\n"
