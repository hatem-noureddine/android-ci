#!/bin/bash
# ==============================================================================
# Android CI Doctor - Diagnostics & Connectivity Verification Tool
# ==============================================================================

set -u

MODE="full"
for arg in "$@"; do
    case "$arg" in
        --summary|-s|--json)
            MODE="json"
            ;;
        --help|-h)
            echo "Usage: ci-doctor [--summary|--json|-s|-h]"
            echo "  (no args)  Run full interactive diagnostic with network connectivity probes"
            echo "  --summary  Output machine-readable JSON status report without network delay"
            echo "  --json     Alias for --summary"
            exit 0
            ;;
        *)
            ;;
    esac
done

BOLD="\033[1m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
CYAN="\033[0;36m"
RED="\033[0;31m"
RESET="\033[0m"

# 1. System & Execution User
OS_ARCH=$(uname -m)
DPKG_ARCH=$(dpkg --print-architecture 2>/dev/null || echo "$OS_ARCH")
CUR_UID=$(id -u)
CUR_GID=$(id -g)
CUR_USER=$(whoami 2>/dev/null || echo 'unknown')

# 2. Java Runtime
JAVA_HOME_VAL="${JAVA_HOME:-Not set}"
JAVA_VER=""
if command -v java >/dev/null 2>&1; then
    JAVA_VER=$(java -version 2>&1 | head -n 1)
fi
AVAILABLE_JDKS=$(find /opt -maxdepth 1 -name "jdk-*" -exec basename {} + 2>/dev/null | tr '\n' ' ')

# 3. Android SDK Components
SDK_HOME_VAL="${ANDROID_HOME:-Not set}"
PLATFORMS=""
if [ -d "${ANDROID_HOME:-/opt/android-sdk}/platforms" ]; then
    PLATFORMS=$(find "${ANDROID_HOME:-/opt/android-sdk}/platforms" -mindepth 1 -maxdepth 1 -exec basename {} + 2>/dev/null | tr '\n' ' ')
fi
BUILD_TOOLS=""
if [ -d "${ANDROID_HOME:-/opt/android-sdk}/build-tools" ]; then
    BUILD_TOOLS=$(find "${ANDROID_HOME:-/opt/android-sdk}/build-tools" -mindepth 1 -maxdepth 1 -exec basename {} + 2>/dev/null | tr '\n' ' ')
fi

# 4. Automation & Deployment Tooling
GRADLE_VER=""
if command -v gradle >/dev/null 2>&1; then
    GRADLE_VER=$(gradle -version 2>&1 | grep "Gradle " | head -n 1 | awk '{print $2}')
fi
FASTLANE_VER=""
if command -v fastlane >/dev/null 2>&1; then
    FASTLANE_VER=$( (fastlane --version 2>&1 || true) | head -n 1 | awk '{print $NF}')
fi
BUNDLETOOL_VER=""
if command -v bundletool >/dev/null 2>&1; then
    BUNDLETOOL_VER="1.18.3"
fi
ANDROID_CLI_VER=""
if command -v android >/dev/null 2>&1; then
    ANDROID_CLI_VER=$( (android --version 2>&1 || true) | head -n 1)
fi
RUBY_VER=""
if command -v ruby >/dev/null 2>&1; then
    RUBY_VER=$(ruby -v 2>&1 | awk '{print $1, $2}')
fi
PYTHON_VER=""
if command -v python3 >/dev/null 2>&1; then
    PYTHON_VER=$(python3 --version 2>&1 | awk '{print $2}')
fi
GH_VER=""
if command -v gh >/dev/null 2>&1; then
    GH_VER=$(gh --version 2>&1 | head -n 1 | awk '{print $3}')
fi

# 5. Network & Internal Adapters
PROXY_VAL="${HTTPS_PROXY:-${HTTP_PROXY:-}}"
CA_COUNT=$(find /certificates /usr/local/share/ca-certificates -maxdepth 1 \( -name "*.crt" -o -name "*.pem" \) 2>/dev/null | wc -l)
MIRROR_VAL="${NEXUS_URLS:-${NEXUS_URL:-${INTERNAL_MAVEN_URL:-}}}"
CACHE_VAL="${GRADLE_BUILD_CACHE_URL:-${GRADLE_REMOTE_CACHE_URL:-}}"

# 6. Android Emulator & KVM
EMU_VERSION=""
if command -v emulator >/dev/null 2>&1; then
    EMU_VERSION=$(emulator -version 2>&1 | head -n 1)
fi
KVM_ACCEL=false
if [ -e /dev/kvm ] && [ -r /dev/kvm ] && [ -w /dev/kvm ]; then
    KVM_ACCEL=true
fi

# ------------------------------------------------------------------------------
# JSON Summary Mode (Fast, Non-Blocking, Machine-Readable for Healthchecks & Agents)
# ------------------------------------------------------------------------------
if [ "$MODE" = "json" ]; then
    HEALTHY=true
    if [ -z "$JAVA_VER" ] || [ -z "$PLATFORMS" ] || [ -z "$GRADLE_VER" ]; then
        HEALTHY=false
    fi

    clean_token() {
        echo "$1" | tr -d '"' | tr -d "\\"
    }

    FORMATTED_JDKS=$(echo "$AVAILABLE_JDKS" | awk '{for(i=1;i<=NF;i++) printf "\"%s\"%s", $i, (i<NF?", ":"")}')
    FORMATTED_PLATFORMS=$(echo "$PLATFORMS" | awk '{for(i=1;i<=NF;i++) printf "\"%s\"%s", $i, (i<NF?", ":"")}')
    FORMATTED_BUILD_TOOLS=$(echo "$BUILD_TOOLS" | awk '{for(i=1;i<=NF;i++) printf "\"%s\"%s", $i, (i<NF?", ":"")}')

    cat <<EOF
{
  "status": $( [ "$HEALTHY" = true ] && echo '"healthy"' || echo '"unhealthy"' ),
  "version": "1.3.2",
  "system": {
    "arch": "$(clean_token "$OS_ARCH")",
    "dpkg_arch": "$(clean_token "$DPKG_ARCH")",
    "uid": $CUR_UID,
    "gid": $CUR_GID,
    "user": "$(clean_token "$CUR_USER")",
    "is_root": $( [ "$CUR_UID" -eq 0 ] && echo "true" || echo "false" )
  },
  "java": {
    "java_home": "$(clean_token "$JAVA_HOME_VAL")",
    "version": "$(clean_token "$JAVA_VER")",
    "available_jdks": [${FORMATTED_JDKS}]
  },
  "android_sdk": {
    "android_home": "$(clean_token "$SDK_HOME_VAL")",
    "platforms": [${FORMATTED_PLATFORMS}],
    "build_tools": [${FORMATTED_BUILD_TOOLS}],
    "android_cli": "$(clean_token "$ANDROID_CLI_VER")",
    "emulator": "$(clean_token "$EMU_VERSION")"
  },
  "tooling": {
    "gradle": "$(clean_token "$GRADLE_VER")",
    "fastlane": "$(clean_token "$FASTLANE_VER")",
    "bundletool": "$(clean_token "$BUNDLETOOL_VER")",
    "ruby": "$(clean_token "$RUBY_VER")",
    "python": "$(clean_token "$PYTHON_VER")",
    "gh": "$(clean_token "$GH_VER")"
  },
  "network": {
    "proxy": "$( [ -n "$PROXY_VAL" ] && clean_token "$PROXY_VAL" || echo "none" )",
    "ca_certificates_count": $CA_COUNT,
    "nexus_mirror": "$( [ -n "$MIRROR_VAL" ] && clean_token "$MIRROR_VAL" || echo "direct" )",
    "build_cache": "$( [ -n "$CACHE_VAL" ] && clean_token "$CACHE_VAL" || echo "local" )"
  },
  "virtualization": {
    "kvm_available": $KVM_ACCEL
  }
}
EOF
    if [ "$HEALTHY" = true ]; then
        exit 0
    else
        exit 1
    fi
fi

# ------------------------------------------------------------------------------
# Full Interactive Terminal Diagnostic
# ------------------------------------------------------------------------------
echo -e "${BOLD}${CYAN}=== Android CI Doctor (hateum/android-ci-box) ===${RESET}\n"

echo -e "${BOLD}1. System & User Execution${RESET}"
echo -e "  OS Architecture : ${OS_ARCH} (${DPKG_ARCH})"
echo -e "  Current User    : UID=${CUR_UID}, GID=${CUR_GID}, User=${CUR_USER}"
if [ "$CUR_UID" -eq 0 ]; then
    echo -e "  Security Mode   : ${YELLOW}Root execution${RESET}"
else
    echo -e "  Security Mode   : ${GREEN}Non-Root / Hardened Runner execution (UID ${CUR_UID})${RESET}"
fi
echo ""

echo -e "${BOLD}2. Java Runtime${RESET}"
echo -e "  JAVA_HOME       : ${JAVA_HOME_VAL}"
if [ -n "$JAVA_VER" ]; then
    echo -e "  Active Version  : ${GREEN}${JAVA_VER}${RESET}"
else
    echo -e "  Active Version  : ${RED}Java not found in PATH!${RESET}"
fi
echo -e "  Available JDKs  : ${AVAILABLE_JDKS:-None}"
echo ""

echo -e "${BOLD}3. Android SDK Components${RESET}"
echo -e "  ANDROID_HOME    : ${SDK_HOME_VAL}"
if [ -n "$PLATFORMS" ]; then
    echo -e "  Platforms       : ${GREEN}${PLATFORMS}${RESET}"
else
    echo -e "  Platforms       : ${RED}None installed${RESET}"
fi
if [ -n "$BUILD_TOOLS" ]; then
    echo -e "  Build Tools     : ${GREEN}${BUILD_TOOLS}${RESET}"
else
    echo -e "  Build Tools     : ${RED}None installed${RESET}"
fi
echo ""

echo -e "${BOLD}4. Automation & CLI Tooling${RESET}"
if [ -n "$GRADLE_VER" ]; then
    echo -e "  Gradle (Global) : ${GREEN}${GRADLE_VER}${RESET}"
else
    echo -e "  Gradle (Global) : ${RED}Not found${RESET}"
fi
if [ -n "$FASTLANE_VER" ]; then
    echo -e "  Fastlane        : ${GREEN}${FASTLANE_VER}${RESET}"
else
    echo -e "  Fastlane        : ${RED}Not found${RESET}"
fi
if [ -n "$BUNDLETOOL_VER" ]; then
    echo -e "  Bundletool      : ${GREEN}1.18.3 wrapper active (/usr/local/bin/bundletool)${RESET}"
else
    echo -e "  Bundletool      : ${RED}Not found${RESET}"
fi
if [ -n "$ANDROID_CLI_VER" ]; then
    echo -e "  Android CLI     : ${GREEN}${ANDROID_CLI_VER}${RESET}"
else
    echo -e "  Android CLI     : ${YELLOW}Not found${RESET}"
fi
echo -e "  Ruby            : ${RUBY_VER:-Not found} (rbenv $(rbenv version-name 2>/dev/null || echo 'n/a'))"
echo -e "  Python 3        : ${PYTHON_VER:-Not found}"
echo -e "  GitHub CLI (gh) : ${GH_VER:-Not found}"
echo ""

echo -e "${BOLD}5. Network Environment & Internal Adapters${RESET}"
if [ -n "$PROXY_VAL" ]; then
    echo -e "  HTTP/HTTPS Proxy: ${YELLOW}Active (${PROXY_VAL})${RESET}"
else
    echo -e "  HTTP/HTTPS Proxy: ${GREEN}Direct / Unrestricted (No proxy set)${RESET}"
fi

if [ "$CA_COUNT" -gt 0 ]; then
    echo -e "  Corporate CA    : ${GREEN}${CA_COUNT} custom certificate(s) detected and registered${RESET}"
else
    echo -e "  Corporate CA    : ${CYAN}Standard Mozilla/Ubuntu root truststore${RESET}"
fi

if [ -n "$MIRROR_VAL" ]; then
    echo -e "  Nexus Mirror    : ${YELLOW}Active -> ${MIRROR_VAL}${RESET}"
    if [ -f "${GRADLE_USER_HOME:-/home/runner/.gradle}/init.d/nexus-mirror.init.gradle" ]; then
        echo -e "  Gradle Init Hook: ${GREEN}nexus-mirror.init.gradle configured${RESET}"
    fi
else
    echo -e "  Nexus Mirror    : ${GREEN}Standard direct repositories (Google, MavenCentral, GradlePortal)${RESET}"
fi

if [ -n "$CACHE_VAL" ]; then
    echo -e "  Build Cache HTTP: ${YELLOW}Active -> ${CACHE_VAL}${RESET}"
    if [ -f "${GRADLE_USER_HOME:-/home/runner/.gradle}/init.d/remote-build-cache.init.gradle" ]; then
        echo -e "  Build Cache Hook: ${GREEN}remote-build-cache.init.gradle configured${RESET}"
    fi
else
    echo -e "  Build Cache HTTP: ${CYAN}Local cache only (No remote HTTP build cache)${RESET}"
fi

echo -e "${BOLD}6. Android Emulator & KVM Hardware Acceleration${RESET}"
if [ -n "$EMU_VERSION" ]; then
    echo -e "  Android Emulator: ${GREEN}${EMU_VERSION}${RESET}"
else
    if [ "$DPKG_ARCH" = "arm64" ] || [ "$DPKG_ARCH" = "aarch64" ]; then
        echo -e "  Android Emulator: ${CYAN}x86_64 only (Google does not publish Linux ARM64 emulator; compilation & unit tests run at native ARM64 speed)${RESET}"
    else
        echo -e "  Android Emulator: ${YELLOW}Not in PATH or not installed${RESET}"
    fi
fi
echo -e "  AVD Directory   : ${ANDROID_AVD_HOME:-/home/runner/.android/avd}"
if [ "$KVM_ACCEL" = true ]; then
    echo -e "  KVM Acceleration: ${GREEN}Available & R/W accessible (/dev/kvm)${RESET}"
elif [ -e /dev/kvm ]; then
    echo -e "  KVM Acceleration: ${YELLOW}Present but check permissions (/dev/kvm)${RESET}"
else
    echo -e "  KVM Acceleration: ${YELLOW}Absent (Fallback: Software emulation swiftshader_indirect)${RESET}"
fi
echo ""

echo -e "${BOLD}7. Connectivity Probes${RESET}"
test_url() {
    local target="$1"
    local name="$2"
    if curl -s -m 3 -o /dev/null "$target"; then
        echo -e "  ${name} : ${GREEN}Reachable (HTTP OK)${RESET}"
    else
        echo -e "  ${name} : ${YELLOW}Unreachable or blocked (HTTP/DNS fail)${RESET}"
    fi
}

test_url "https://dl.google.com" "Google Android Maven (dl.google.com)"
test_url "https://repo.maven.apache.org" "Maven Central (repo.maven.apache.org)"

if [ -n "$MIRROR_VAL" ]; then
    CLEAN_NEXUS=$(echo "$MIRROR_VAL" | cut -d',' -f1 | tr -d ' ')
    test_url "$CLEAN_NEXUS" "Corporate Nexus (${CLEAN_NEXUS})"
fi

echo -e "\n${BOLD}${GREEN}✔ CI Doctor diagnostics complete!${RESET}\n"
